# Template for .env - copy this file to .env and fill in real values for
# this host. .env itself holds a real password, so it's host-specific and
# should never be copied between hosts or committed anywhere shared.
#
#   cp .env.example .env

# gid of the host's "docker" group, so the API container's non-root user
# can read /var/run/docker.sock. Check with: getent group docker
DOCKER_GID=986

# Login for the whole dashboard (api/src/features/auth/credentials.js -
# real login screen with a persistent session, not a browser popup).
#
# Leave BASIC_AUTH_PASSWORD blank (recommended): the first time anyone opens
# the dashboard, they get a "first access" screen to set their own
# username/password right in the browser (with a "generate a strong
# password" button) - nothing to pre-fill here.
#
# Only set these two if you're deploying unattended/scripted and need the
# login ready before anyone ever opens a browser to it - they just seed the
# very first login then. Once a login exists (either way), these have no
# effect anymore - change it from the Settings screen, not by editing this
# file.
#   openssl rand -base64 18 | tr -dc 'A-Za-z0-9' | head -c 24
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=

# Notifications (Telegram - api/src/features/notifications/). Only needed
# if you plan to configure a Telegram bot from the Settings screen - leave
# blank otherwise, the rest of the dashboard works fine without it (that
# panel just shows an error asking for this to be set).
#
# Encrypts the bot token and each route's chat id at rest (AES-256-GCM) -
# generate one and NEVER change it once notifications are configured:
# changing it makes everything already saved permanently unreadable, with
# no recovery (same "no recovery" rule as the login password).
#   openssl rand -hex 32
APP_ENCRYPTION_KEY=
